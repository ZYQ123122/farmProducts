<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysUserMapper">

	<resultMap type="SysUser" id="SysUserResult">
		<id     property="id"            column="id"              />
		<result property="username"      column="username"        />
		<result property="passwordHash"  column="password_hash"   />
		<result property="role"          column="role"            />
		<result property="name"         column="name"             />
		<result property="contact"      column="contact"         />
		<result property="email"        column="email"           />
		<result property="phone"        column="phone"           />
		<result property="isVerified"  column="is_verified"     />
		<result property="createdAt"    column="created_at"     />
		<result property="updatedAt"    column="updated_at"      />
	</resultMap>

	<sql id="selectUserVo">
		select id, username, password_hash, role, name, contact, email, phone, is_verified, created_at, updated_at
		from sys_user
	</sql>

	<select id="selectUserList" parameterType="SysUser" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		<where>
			<if test="id != null and id != 0">
				AND id = #{id}
			</if>
			<if test="username != null and username != ''">
				AND username like '%' + #{username} + '%'
			</if>
			<if test="role != null and role != ''">
				AND role = #{role}
			</if>
			<if test="name != null and name != ''">
				AND name like '%' + #{name} + '%'
			</if>
			<if test="phone != null and phone != ''">
				AND phone like '%' + #{phone} + '%'
			</if>
			<if test="email != null and email != ''">
				AND email like '%' + #{email} + '%'
			</if>
			<if test="isVerified != null">
				AND is_verified = #{isVerified}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''">
				AND FORMAT(created_at,'yyyyMMdd') &gt;= FORMAT(#{params.beginTime},'yyyyMMdd')
			</if>
			<if test="params.endTime != null and params.endTime != ''">
				AND FORMAT(created_at,'yyyyMMdd') &lt;= FORMAT(#{params.endTime},'yyyyMMdd')
			</if>
		</where>
	</select>

	<select id="selectUserByLoginName" parameterType="String" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where username = #{userName}
	</select>

	<select id="selectUserByPhoneNumber" parameterType="String" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where phone = #{phoneNumber}
	</select>

	<select id="selectUserByEmail" parameterType="String" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where email = #{email}
	</select>

	<select id="checkLoginNameUnique" parameterType="String" resultMap="SysUserResult">
		select top 1 <include refid="selectUserVo"/>
		where username = #{loginName}
	</select>

	<select id="checkPhoneUnique" parameterType="String" resultMap="SysUserResult">
		select top 1 <include refid="selectUserVo"/>
		where phone = #{phonenumber}
	</select>

	<select id="checkEmailUnique" parameterType="String" resultMap="SysUserResult">
		select top 1 <include refid="selectUserVo"/>
		where email = #{email}
	</select>

	<select id="selectUserById" parameterType="Long" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where id = #{userId}
	</select>

	<delete id="deleteUserById" parameterType="Long">
		delete from sys_user where id = #{userId}
	</delete>

	<delete id="deleteUserByIds" parameterType="Long">
		delete from sys_user where id in
		<foreach collection="array" item="userId" open="(" separator="," close=")">
			#{userId}
		</foreach>
	</delete>

	<update id="resetUserPwd">
		update sys_user SET password_hash = #{password}, updated_at = GETDATE() where id = #{userId}
	</update>

	<update id="updateUser" parameterType="SysUser">
		update sys_user
		<set>
			<if test="username != null and username != ''">username = #{username},</if>
			<if test="passwordHash != null and passwordHash != ''">password_hash = #{passwordHash},</if>
			<if test="role != null and role != ''">role = #{role},</if>
			<if test="name != null">name = #{name},</if>
			<if test="contact != null">contact = #{contact},</if>
			<if test="email != null">email = #{email},</if>
			<if test="phone != null">phone = #{phone},</if>
			<if test="isVerified != null">is_verified = #{isVerified},</if>
			updated_at = GETDATE()
		</set>
		where id = #{id}
	</update>

	<insert id="insertUser" parameterType="SysUser" useGeneratedKeys="true" keyProperty="id">
		insert into sys_user(
		<if test="id != null and id != 0">id,</if>
		username,
		password_hash,
		role,
		<if test="name != null and name != ''">name,</if>
		<if test="contact != null and contact != ''">contact,</if>
		<if test="email != null and email != ''">email,</if>
		<if test="phone != null and phone != ''">phone,</if>
		<if test="isVerified != null">is_verified,</if>
		created_at,
		updated_at
		)values(
		<if test="id != null and id != 0">#{id},</if>
		#{username},
		#{passwordHash},
		#{role},
		<if test="name != null and name != ''">#{name},</if>
		<if test="contact != null and contact != ''">#{contact},</if>
		<if test="email != null and email != ''">#{email},</if>
		<if test="phone != null and phone != ''">#{phone},</if>
		<if test="isVerified != null">#{isVerified},</if>
		GETDATE(),
		GETDATE()
		)
	</insert>

	<!-- 兼容旧方法 -->
	<select id="selectAllocatedList" parameterType="SysUser" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where 1=0
	</select>

	<select id="selectUnallocatedList" parameterType="SysUser" resultMap="SysUserResult">
		<include refid="selectUserVo"/>
		where 1=0
	</select>

	<update id="updateUserAvatar">
		update sys_user set updated_at = GETDATE() where id = #{userId}
	</update>

	<update id="updateUserStatus">
		update sys_user SET is_verified = CAST(#{status} AS BIT), updated_at = GETDATE() where id = #{userId}
	</update>

	<update id="updateLoginInfo">
		update sys_user set updated_at = GETDATE() where id = #{userId}
	</update>

</mapper>
